---
interface Props {
  url: string;
}
const { url } = Astro.props;
---

<div class="copy-llms-url">
  <code class="url-display">{url}</code>
  <button
    class="copy-btn"
    data-url={url}
    aria-label={`Copy ${url} to clipboard`}
  >
    Copy
  </button>
  <span class="feedback" aria-live="polite" aria-atomic="true"></span>
</div>

<style>
  .copy-llms-url {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    margin: 1rem 0;
  }

  .url-display {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-all;
    font-size: 0.875rem;
    color: var(--sl-color-text);
  }

  .copy-btn {
    flex-shrink: 0;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-accent);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .copy-btn:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .feedback {
    font-size: 0.8rem;
    color: var(--sl-color-green);
    min-width: 4rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url ?? '';
      const feedback = btn.closest('.copy-llms-url')?.querySelector<HTMLElement>('.feedback');
      try {
        await navigator.clipboard.writeText(url);
        if (feedback) {
          feedback.textContent = 'Copied!';
          setTimeout(() => { feedback.textContent = ''; }, 2000);
        }
      } catch {
        if (feedback) {
          feedback.textContent = 'Failed';
          setTimeout(() => { feedback.textContent = ''; }, 2000);
        }
      }
    });
  });
</script>
