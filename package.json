{
	"name": "@tigorhutasuhut/telemetry-js",
	"version": "1.1.2",
	"description": "OpenTelemetry SDK setup abstraction for multiple runtimes",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./cloudflare": {
			"types": "./dist/cloudflare/index.d.ts",
			"default": "./dist/cloudflare/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./dist/node/index.js"
		},
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"default": "./dist/browser/index.js"
		},
		"./browser/fetch": {
			"types": "./dist/browser/fetch/index.d.ts",
			"default": "./dist/browser/fetch/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/tigorlazuardi/telemetry-js.git"
	},
	"scripts": {
		"prepublishOnly": "tsc",
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"docs:generate": "typedoc",
		"prepare": "husky"
	},
	"packageManager": "pnpm@10.30.0",
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.212.0",
		"@opentelemetry/core": "^2.5.1",
		"@opentelemetry/exporter-logs-otlp-http": "^0.212.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
		"@opentelemetry/otlp-transformer": "^0.212.0",
		"@opentelemetry/resources": "^2.5.1",
		"@opentelemetry/sdk-logs": "^0.212.0",
		"@opentelemetry/sdk-metrics": "^2.5.1",
		"@opentelemetry/sdk-node": "^0.212.0",
		"@opentelemetry/sdk-trace-base": "^2.5.1",
		"@opentelemetry/semantic-conventions": "^1.39.0"
	},
	"peerDependencies": {
		"pino": ">=8.0.0"
	},
	"peerDependenciesMeta": {
		"pino": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@types/node": "^25.3.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.0",
		"typedoc": "^0.28.17",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
